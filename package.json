{
  "name": "dsh-auto-workspace",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "DSH 插件：新建分区时跳过目录选择对话框，自动创建 default-workspace-N 分区；分区名前缀可在插件后台自定义，删除分区时连磁盘文件夹一并清理。",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "install.bat",
    "install.ps1",
    "install.sh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feiyuwan09/dsh-auto-workspace.git"
  },
  "homepage": "https://github.com/Feiyuwan09/dsh-auto-workspace#readme",
  "bugs": {
    "url": "https://github.com/Feiyuwan09/dsh-auto-workspace/issues"
  },
  "author": "Feiyuwan09",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workspace",
    "directory-picker",
    "auto-workspace"
  ]
}
